{
    "version": "2.3.1",
    "description": "ImgDrive is a lightweight virtual CD/DVD/Blu-ray drive that enables to emulate up all popular image types of CD, DVD and Blu-ray Discs to drives.",
    "homepage": "https://www.yubsoft.com/imgdrive/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://download.yubsoft.com/imgdrive_2.3.1_portable.zip",
            "hash": "bd3d30465801ce96f58fe865f1bdd013364451305caf3a2a7d52d6875f68015c",
            "extract_dir": "imgdrive_x64"
        }
    },
    "checkver": {
        "url": "https://www.yubsoft.com/imgdrive/",
        "regex": "ImgDrive ([\\d.]+)"
    },
    "shortcuts": [
        [
            "imgdrive.exe",
            "ImgDrive"
        ]
    ],
    "persist": "imgdrive.ini",
    "pre_install": "if (!(Test-Path \"$persist_dir\\imgdrive.ini\")) { New-Item -Path \"$persist_dir\\imgdrive.ini\" -ItemType File -Force | Out-Null }",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.yubsoft.com/imgdrive_$version_portable.zip",
                "hash": {
                    "url": "$url.sha256sum"
                }
            }
        }
    }
}
